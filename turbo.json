{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV", "CI", "TZ"],
  "globalDependencies": [".env.test"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "outputs": [".next/**", "!.next/cache/**", "storybook-static/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_*",
        "RESEND_*",
        "NEXT_PUBLIC_*",
        "PUBLIC_API_ENABLED",
        "MAIL_*",
        "APP_*"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^db:generate"]
    },
    "db:generate": {
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["src/generated/**"]
    },
    "typecheck": {
      "dependsOn": ["^db:generate", "db:generate"]
    },
    "lint": {
      "dependsOn": ["^db:generate", "db:generate"]
    },
    "test": {
      "dependsOn": ["^db:generate", "db:generate"],
      "outputs": ["coverage/**"],
      "env": ["DATABASE_URL", "TEST_DATABASE_URL"]
    },
    "test:storybook": {
      "dependsOn": ["^db:generate"],
      "outputs": []
    },
    "test:ui": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:api": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:visual": {
      "cache": false
    }
  }
}
