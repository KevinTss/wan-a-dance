{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm verify*)",
      "Bash(pnpm test*)",
      "Bash(pnpm turbo run *)",
      "Bash(pnpm --filter * exec tsc*)",
      "Bash(pnpm --filter * exec eslint*)",
      "Bash(pnpm --filter * exec vitest*)",
      "Bash(pnpm check:*)",
      "Bash(pnpm db:up)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(pnpm --filter @wad/db db:reset*)",
      "Read(./**/.env)",
      "Read(./**/.env.local)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-file.mjs\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-on-stop.mjs\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
